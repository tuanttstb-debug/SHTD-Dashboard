      <div id="qvDoneList"></div>
    </div>

    <!-- ── TAB 2: Next Month Plan ── -->
    <div class="qvp-pane" id="qvPane-plan">
      <div class="qvp-section-title"><i class="fa-solid fa-rocket" style="color:var(--accent);"></i> Kế hoạch tháng tới</div>
      <div id="qvPlanList"></div>
